% projectreport.sty — paquete de estilo para el informe SalesHealth (UAX, 2025/26)
% Adaptado a partir de la plantilla de proyecto del usuario, eliminando todo
% el aparato de bibliografía (biblatex, biber, references.bib) por petición
% del enunciado del proyecto.
\ProvidesPackage{projectreport}[2026/05/11 v1.0 Informe SalesHealth UAX]

% --- Geometría y tipografía ---------------------------------------------------
\usepackage[a4paper, top=2.5cm, bottom=2.5cm, left=2.6cm, right=2.6cm,
            headheight=14pt]{geometry}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
% Internacionalización: se intenta cargar babel-spanish (texlive-lang-spanish);
% si no está disponible, recae en english con etiquetas adaptadas manualmente
% más abajo. El cuerpo del documento es en español en cualquier caso.
\IfFileExists{spanish.ldf}{%
  \usepackage[spanish,es-tabla]{babel}%
}{%
  \usepackage[english]{babel}%
  \addto\captionsenglish{%
    \renewcommand\chaptername{Cap\'\i tulo}%
    \renewcommand\appendixname{Ap\'endice}%
    \renewcommand\contentsname{\'Indice}%
    \renewcommand\listfigurename{\'Indice de figuras}%
    \renewcommand\listtablename{\'Indice de tablas}%
    \renewcommand\figurename{Figura}%
    \renewcommand\tablename{Tabla}%
    \renewcommand\bibname{Referencias}%
  }%
  \AtBeginDocument{%
    \providecommand\lstlistlistingname{Listings}%
    \providecommand\lstlistingname{Listing}%
    \renewcommand\lstlistlistingname{\'Indice de listados}%
    \renewcommand\lstlistingname{Listado}%
  }%
}
\usepackage{lmodern}
\usepackage{microtype}
\usepackage{setspace}
\onehalfspacing

% Evita overfull hbox cuando hay listas largas de \texttt con underscores
% que TeX no puede partir: damos margen interpalabra y modo "sloppy" global.
\setlength{\emergencystretch}{3em}
\sloppy
\hbadness=10000               % silencia los avisos de cajas casi-perfectas
\hfuzz=2pt                    % tolera 2pt de exceso silenciosamente

% --- Cabeceras y pies ---------------------------------------------------------
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\nouppercase\leftmark}
\fancyhead[R]{\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \fancyfoot[C]{\thepage}%
}

