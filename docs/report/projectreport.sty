% --- Paleta de colores para listings ------------------------------------------
\definecolor{kw}{HTML}{1F4E79}
\definecolor{cm}{HTML}{6A737D}
\definecolor{st}{HTML}{B03030}
\definecolor{bg}{HTML}{F7F7F2}
\definecolor{ln}{HTML}{888888}

\lstdefinestyle{plain}{
  basicstyle=\ttfamily\footnotesize,
  keywordstyle=\color{kw}\bfseries,
  commentstyle=\color{cm}\itshape,
  stringstyle=\color{st},
  backgroundcolor=\color{bg},
  numbers=left,
  numberstyle=\tiny\color{ln},
  numbersep=8pt,
  showstringspaces=false,
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  frame=single,
  framerule=0.4pt,
  rulecolor=\color{black!20},
  xleftmargin=1.2em,
  belowcaptionskip=4pt,
  aboveskip=10pt,
  belowskip=10pt,
  tabsize=2,
  literate={ñ}{{\~n}}1 {Ñ}{{\~N}}1
           {á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
           {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
           {¿}{{?`}}1 {¡}{{!`}}1
           {—}{{---}}1 {–}{{--}}1
           {“}{{``}}1 {”}{{''}}1
           {…}{{\ldots}}1 {€}{{\texteuro}}1
}
\lstset{style=plain}

\lstdefinelanguage{SQLpostgres}[]{SQL}{
  morekeywords={returning,with,using,coalesce,extract,interval,to_char,generate_series,
                least,greatest,truncate,insert,update,delete,merge,boolean,date,timestamp,
                numeric,smallint,int,bigint,serial,primary,key,foreign,references,check,
                unique,not,null,table,view,index,schema,create,drop,cascade,restart,identity}
}

% --- Teoremas (definición/proposición/observación) ---------------------------
\newtheoremstyle{infmstyle}%
  {0.6em}{0.6em}{\normalfont}{}{\bfseries}{.}{ }{}
\theoremstyle{infmstyle}
% Si el documento es `article`, no existe el contador `chapter`; numeramos
% los teoremas por sección. Si es `report` o `book`, usamos `chapter`.
\@ifundefined{chapter}{%
  \newtheorem{definicion}{Definición}[section]%
}{%
  \newtheorem{definicion}{Definición}[chapter]%
}
\newtheorem{proposicion}[definicion]{Proposición}
\newtheorem*{observacion}{Observación}

